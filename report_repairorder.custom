<xpath expr="//t[@t-name='repair.report_repairorder']" position="replace">
    <t t-name="repair.report_repairorder">
        <t t-set="o" t-value="doc"/>
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
                <div class="page">
                    <div class="oe_structure"/>
                    <h2>
                        <span>Repair Order #</span>
                        <span t-field="o.name">RO123456</span>
                    </h2>
                    <div class="oe_structure"/>
                    <div id="informations" class="row mb-3">
                        <div class="col-6">
                            <p t-if="o.partner_id" class="m-0">
                                <strong>Customer:</strong>
                                <span t-field="o.partner_id">John Doe</span>
                            </p>
                            <p t-if="o.product_id" class="m-0">
                                <strong>Product:</strong>
                                <span t-field="o.product_id">Laptop</span>
                            </p>
                            <p t-if="o.x_placa" class="m-0">
                                <strong>Placa:</strong> <span t-field="o.x_placa"/>
                            </p>
                            <p t-if="o.x_marca" class="m-0">
                                <strong>Marca:</strong> <span t-field="o.x_marca"/>
                            </p>
                            <p t-if="o.x_marca" class="m-0">
                                <strong>Modelo:</strong> <span t-field="o.x_modelo"/>
                            </p>
                            <p t-if="o.x_color" class="m-0">
                                <strong>Color:</strong> <span t-field="o.x_color"/>
                            </p>
                            <p t-if="o.x_anio" class="m-0">
                                <strong>Año:</strong> <span t-field="o.x_anio"/>
                            </p>
                            <p t-if="o.lot_id" class="m-0" groups="stock.group_production_lot">
                                <strong>Lot/Serial:</strong>
                                <span t-field="o.lot_id">L12345</span>
                            </p>
                        </div>
                        <div class="col-6">
                            <p class="m-0">
                                <strong>Status:</strong>
                                <span t-field="o.state">Pending</span>
                            </p>
                            <p t-if="o.user_id" class="m-0">
                                <strong>Responsible:</strong>
                                <span t-field="o.user_id">Jane Smith</span>
                            </p>
                        </div>
                    </div>
                    <div class="oe_structure"/>

                    <!-- ========================================== -->
                    <!-- TABLA 1: REPUESTOS (campo nativo move_ids) -->
                    <!-- ========================================== -->
                    <t t-if="o.move_ids">
                        <h2 class="mb-3 border-bottom border-2 border-dark">Repuestos</h2>
                        <table class="table table-sm o_main_table mb-4">
                            <thead style="border-bottom: 2px solid black;">
                                <tr>
                                    <th>Descripción del Repuesto</th>
                                    <th class="text-end">Cantidad</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.move_ids" t-as="line" style="border-bottom: 1px solid #ddd;">
                                    <td class="py-2"><span t-field="line.product_id.name"/></td>
                                    <td class="text-end py-2">
                                        <span t-field="line.product_uom_qty"/> <span groups="uom.group_uom" t-field="line.uom_id.name"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </t>

                    <!-- ================================================= -->
                    <!-- TABLA 2: SERVICIOS (campo nativo                   -->
                    <!-- repair_service_line_ids)                            -->
                    <!-- ================================================= -->
                    <t t-if="o.repair_service_line_ids">
                        <h2 class="mb-3 border-bottom border-2 border-dark mt-4">Servicios</h2>
                        <table class="table table-sm o_main_table mb-4">
                            <thead style="border-bottom: 2px solid black;">
                                <tr>
                                    <th>Descripción del Trabajo</th>
                                    <th class="text-end">Cantidad</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.repair_service_line_ids" t-as="line" style="border-bottom: 1px solid #ddd;">
                                    <td class="py-2">
                                        <span t-if="line.description" t-field="line.description"/>
                                        <span t-else="" t-field="line.product_id.name"/>
                                    </td>
                                    <td class="text-end py-2">
                                        <span t-field="line.quantity"/> <span groups="uom.group_uom" t-field="line.uom_id.name"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </t>

                    <div class="oe_structure"/>

                    <!-- NOTAS (Opcional, si quieres que salgan las notas internas) -->
                    <div t-if="o.internal_notes">
                        <h2 class="mb-3 border-bottom border-2 border-dark">Notas de Reparación</h2>
                        <span t-field="o.internal_notes">This is a repair note.</span>
                    </div>

                    <div class="oe_structure"/>
                    
                    <!-- ================================================================= -->
                    <!-- SALTO DE PÁGINA: AQUÍ EMPIEZA LA HOJA EXCLUSIVA DEL ALMACENERO    -->
                    <!-- ================================================================= -->
                    <div style="page-break-before: always;"/>

                    <!-- ========================================== -->
                    <!-- ANEXO: VALE DE REPUESTOS PARA ALMACÉN      -->
                    <!-- ========================================== -->
                        <div class="mt-4">
                        <h3 class="border-bottom border-dark pb-2 mb-4">Anexo: DESPACHO ALMACEN</h3>
                        <t t-if="o.move_ids">
                            <table class="table table-sm o_main_table mb-4">
                                <thead style="border-bottom: 2px solid black;">
                                    <tr>
                                        <th>Descripción del Repuesto</th>
                                        <th>Ubicación (Estante)</th>
                                        <th class="text-end">Cantidad a Despachar</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Iteramos sobre los movimientos y sus líneas detalladas de ubicación -->
                                    <t t-foreach="o.move_ids" t-as="move">
                                        <t t-foreach="move.move_line_ids" t-as="line">
                                            <tr style="border-bottom: 1px solid #ddd;">
                                                <td class="py-2">
                                                    <!-- Se añadió la referencia interna (default_code) -->
                                                    <span t-if="move.product_id.default_code">[<span t-field="move.product_id.default_code"/>] </span>
                                                    <span t-field="move.product_id.name"/>
                                                </td>
                                                <td class="py-2">
                                                    <strong><span t-field="line.location_id.complete_name"/></strong>
                                                </td>
                                                <td class="text-end py-2">
                                                    <span t-field="line.quantity"/> <span groups="uom.group_uom" t-field="line.uom_id.name"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        </div>

                    <!-- Corta la hoja antes del anexo -->
                    <div style="page-break-before: always;"/>
                         <!-- ========================================== -->
                         <!-- ANEXO: CHECKLIST -->
                         <!-- ========================================== -->
                        <div class="mt-4">
                            <h3 class="border-bottom border-dark pb-2 mb-4">Anexo: Checklist de Ingreso y Evidencia</h3>

                            <!-- Sección 1: Casillas y Daños -->
                            <div class="mb-4" style="font-size: 14px;">
                                <p><strong>Check list de ingreso:</strong></p>
                                <div class="row">
                                    <div class="col-6">
                                        <ul class="list-unstyled">
                                            <li><t t-if="o.x_chk_kilometraje">☑</t><t t-else="">☐</t> Kilometraje: <span t-field="o.x_chk_kilometraje"/></li>
                                            <li>Nivel de Combustible: <strong><span t-field="o.x_chk_nivelcombustible"/></strong></li>
                                            <li><t t-if="o.x_chk_plumillas">☑</t><t t-else="">☐</t> Plumillas</li>
                                            <li><t t-if="o.x_chk_llanta">☑</t><t t-else="">☐</t> Llanta repuesto</li>
                                            <li><t t-if="o.x_chk_llave_ruedas">☑</t><t t-else="">☐</t> Llave de ruedas</li>
                                            <li><t t-if="o.x_chk_llave_birlos">☑</t><t t-else="">☐</t> Llave de birlos</li>
                                            <li><t t-if="o.x_chk_gata">☑</t><t t-else="">☐</t> Gata y herramientas</li>
                                        </ul>
                                    </div>
                                    <div class="col-6">
                                        <ul class="list-unstyled">
                                            <li><t t-if="o.x_chk_extintor">☑</t><t t-else="">☐</t> Extintor</li>
                                            <li><t t-if="o.x_chk_radio">☑</t><t t-else="">☐</t> Radio / Pantalla</li>
                                            <li><t t-if="o.x_chk_claxon">☑</t><t t-else="">☐</t> Claxon</li>
                                            <li><t t-if="o.x_chk_tarjetacirculacion">☑</t><t t-else="">☐</t> Tarjeta Circulación</li>
                                            <li><t t-if="o.x_chk_tapetes">☑</t><t t-else="">☐</t> Tapetes</li>
                                            <li><t t-if="o.x_chk_tapa_combustible">☑</t><t t-else="">☐</t> Tapa combustible</li>
                                            <li><t t-if="o.x_chk_tapacubos">☑</t><t t-else="">☐</t> Tapacubos</li>
                                        </ul>
                                    </div>
                                </div>
                                
                                <hr/>
                                
                                <p><strong>Estado de Carrocería:</strong></p>
                                <div class="row">
                                    <div class="col-6">
                                        <p class="m-0"><t t-if="o.x_chk_espejos_laterales">☑</t><t t-else="">☐</t> Espejos laterales</p>
                                        <p class="m-0"><t t-if="o.x_chk_cristales">☑</t><t t-else="">☐</t> Cristales</p>
                                        <p class="m-0"><t t-if="o.x_chk_faros_posteriores">☑</t><t t-else="">☐</t> Faros posteriores</p>
                                    </div>
                                    <div class="col-6">
                                        <p class="m-0"><t t-if="o.x_chk_farosdelanteros">☑</t><t t-else="">☐</t> Faros delanteros</p>
                                        <p class="m-0"><t t-if="o.x_chk_observacionesgenerales">☑</t><t t-else="">☐</t> Observaciones generales</p>
                                    </div>
                                </div>
    
                                <t t-if="o.x_chk_raspones">
                                    <p class="mt-3 text-danger"><strong>⚠️ Daños en carrocería reportados al ingreso:</strong></p>
                                    <p class="m-0 border p-2"><span t-field="o.x_detalle_raspones"/></p>
                                </t>
                                <t t-else="">
                                    <p class="mt-3">☑ Sin daños de carrocería reportados al ingreso.</p>
                                </t>
                            </div>
                    

                            <!-- Sección 2: Fotos hacia abajo -->
                            <div class="mt-4">
                                <p><strong>Registro Fotográfico:</strong></p>
                                <div class="row">
                                    <!-- Foto 1 -->
                                    <div class="col-3 text-center" t-if="o.x_chk_foto1">
                                        <p class="mb-1 text-muted" style="font-size: 12px;">Foto 1</p>
                                        <span t-field="o.x_chk_foto1" t-options="{'widget': 'image', 'style': 'max-width: 100%; max-height: 230px; border: 1px solid #ddd; padding: 2px;'}"/>
                                    </div>
                                    <!-- Foto 2 -->
                                    <div class="col-3 text-center" t-if="o.x_chk_foto2">
                                        <p class="mb-1 text-muted" style="font-size: 12px;">Foto 2</p>
                                        <span t-field="o.x_chk_foto2" t-options="{'widget': 'image', 'style': 'max-width: 100%; max-height: 230px; border: 1px solid #ddd; padding: 2px;'}"/>
                                    </div>
                                    <!-- Foto 3 -->
                                    <div class="col-3 text-center" t-if="o.x_chk_foto3">
                                        <p class="mb-1 text-muted" style="font-size: 12px;">Foto 3</p>
                                        <span t-field="o.x_chk_foto3" t-options="{'widget': 'image', 'style': 'max-width: 100%; max-height: 230px; border: 1px solid #ddd; padding: 2px;'}"/>
                                    </div>
                                    <!-- Foto 4 -->
                                    <div class="col-3 text-center" t-if="o.x_chk_foto4">
                                        <p class="mb-1 text-muted" style="font-size: 12px;">Foto 4</p>
                                        <span t-field="o.x_chk_foto4" t-options="{'widget': 'image', 'style': 'max-width: 100%; max-height: 230px; border: 1px solid #ddd; padding: 2px;'}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                </div>
            </t>
    </t>
</xpath>
