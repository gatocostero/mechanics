<data>

    <!-- ============================================================ -->
    <!-- TRUCO: Forzar el div "article" hacia arriba con margen        -->
    <!-- negativo, ya que padding-top:0 no fue suficiente para cerrar  -->
    <!-- el espacio (probablemente hay más de una fuente empujándolo). -->
    <!-- ============================================================ -->
    <xpath expr="//div[contains(@t-attf-class, 'article')]" position="attributes">
        <attribute name="style">margin-top: 0px !important; padding-top: 0px !important;</attribute>
    </xpath>

</data>
