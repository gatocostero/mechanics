<data>

    <!-- ============================================================ -->
    <!-- TRUCO: Agregar Placa, Marca y Modelo como campos de búsqueda  -->
    <!-- en la caja de "Buscar...".                                     -->
    <!-- ============================================================ -->
    <xpath expr="//field[@name='product_id']" position="after">
        <field name="x_placa" string="Placa"/>
        <field name="x_marca" string="Marca"/>
        <field name="x_modelo" string="Modelo"/>
    </xpath>

</data>
