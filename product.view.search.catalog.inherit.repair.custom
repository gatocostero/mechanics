<data>


    <xpath expr="//field[@name='product_tag_ids']" position="after">
        <field name="additional_product_tag_ids" string="Etiqueta de la variante servicios"/>
    </xpath>

    <xpath expr="//searchpanel" position="inside">
        <field name="additional_product_tag_ids" string="Tipo de vehículo" icon="fa-car" enable_counters="1" select="multi"/>
    </xpath>
</data>
